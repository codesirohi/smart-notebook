# ---------------------------------------------------------
# Smart Notebook - Production Environment Variables Template
# ---------------------------------------------------------

# SPRING BOOT API (e.g. Render Web Service)
# ---------------------------------------------------------
# Set the active profile to load application-prod.yml
SPRING_PROFILES_ACTIVE=prod

# Database Connection (Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR_SUPABASE_ID].supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_supabase_password

# Authentication / Security
MODEL_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Google Drive Storage Provider
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"..._YOUR_JSON_KEY_CONTENTS"}
GDRIVE_FOLDER_ID=optional_google_drive_folder_id

# ---------------------------------------------------------
# PYTHON BACKGROUND WORKER (e.g. Render Background Worker)
# ---------------------------------------------------------
# Local Model Features
LOCAL_MODELS_ENABLED=false

# Database Connection (Supabase Standard format)
DATABASE_URL=postgresql://postgres:your_secure_supabase_password@db.[YOUR_SUPABASE_ID].supabase.co:5432/postgres

# AI Provider Keys
# Since local Ollama cannot run on Render, a cloud provider is required.
# Groq is recommended for free, fast inference (Llama-3).
GROQ_API_KEY=gsk_your_groq_api_key

# Global Pipeline Overrides
EXTRACTION_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=nomic-embed-text # Assuming you configure an external embedding provider or fall back to an API that offers embeddings
# NOTE: If using Groq, they don't natively host nomic. You may need to use OpenAI's free tier for embeddings.
# OPENAI_API_KEY=sk-proj-...
# EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------
# FRONTEND UI (e.g. Cloudflare Pages / Vercel)
# ---------------------------------------------------------
VITE_API_URL=https://your-render-app-name.onrender.com
